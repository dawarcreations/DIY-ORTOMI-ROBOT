void runExpressionD() {
  // Step 1: Animate smoothly up to an4 (indices 0 to 3)
  for (int i = 0; i <= 3; i++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_d[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(20);
  }

  // Step 2: Hold at an4 (index 3) and deliberate for 2 seconds
  display.clearDisplay();
  display.drawBitmap(0, 0, expression_d[3], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  delay(2000);

  // Step 3: Decide whether to escalate to extreme (an5/an6) or stay at an4
  int targetIndex = 3; 
  bool goExtreme = (random(0, 2) == 1); 

  if (goExtreme) {
    for (int i = 4; i <= 5; i++) {
      display.clearDisplay();
      display.drawBitmap(0, 0, expression_d[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      delay(25);
    }
    targetIndex = 5; 
  }

  // Step 4: Hold the chosen expression state
  unsigned long angry_hold = random(3000, 7001);
  display.clearDisplay();
  display.drawBitmap(0, 0, expression_d[targetIndex], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  delay(angry_hold);

  // Step 5: Smoothly reverse back down
  for (int i = targetIndex - 1; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_d[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(20);
  }
}

void runExpressionE() {
  // Step 1: Animate smoothly into the sad expression (sd1 -> sa1 -> sa2 -> sa3)
  for (int i = 0; i < 4; i++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_E[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(35);
  }

  // Step 2: Hold the sad face (sa3) for a random duration
  unsigned long sad_hold = random(3000, 8000);
  display.clearDisplay();
  display.drawBitmap(0, 0, expression_E[3], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  delay(sad_hold);

  // Step 3: Smoothly reverse back down through the sad frames (sa2 -> sa1 -> sd1)
  for (int i = 2; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_E[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(35);
  }

  // Step 4: Instantly transition back to the main sinister face
  display.clearDisplay();
  display.drawBitmap(0, 0, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
}

void runExpressionF() {
  // Step 1: Smoothly animate into sleep (sL1 up to sl10, indices 0 to 9)
  for (int i = 0; i < 10; i++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_F[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(35);
    if (digitalRead(TOUCH_PIN) == HIGH) {
      handleTouchAction();
      return;
    }
  }

  // Step 2: Deep sleep breathing loop with ZZZ (sl10 to sl13 / indices 9 to 12) for 6 minutes
  unsigned long sleepStart = millis();
  unsigned long sleepDuration = 360000UL; // 6 minutes
  
  while (millis() - sleepStart < sleepDuration) {
    int breathFrames[6] = {9, 10, 11, 12, 11, 10};
    for (int k = 0; k < 6; k++) {
      display.clearDisplay();
      display.drawBitmap(0, 0, expression_F[breathFrames[k]], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      
      unsigned long frameStart = millis();
      while (millis() - frameStart < 350) {
        if (digitalRead(TOUCH_PIN) == HIGH) {
          handleTouchAction();
          return;
        }
        delay(15);
      }
      
      if (millis() - sleepStart >= sleepDuration) break;
    }
  }

  // Step 3: Smoothly reverse back down from sl10 down to sL1 (indices 9 down to 0)
  for (int i = 9; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_F[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(35);
  }

  // Step 4: Transition back to sinister face
  display.clearDisplay();
  display.drawBitmap(0, 0, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
}

