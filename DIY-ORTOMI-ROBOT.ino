void runExpressionA() {
  for (int i = 0; i < 6; i++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_a[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(1);
  }
  int random_hold = random(500, 3000);
  display.clearDisplay();
  display.drawBitmap(0, 0, expression_a[5], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  delay(random_hold);

  for (int i = 4; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_a[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(1);
  }
}

void runExpressionB() {
