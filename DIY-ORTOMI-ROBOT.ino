// =====================================================================
// DEDICATED BLINK FUNCTION (Strictly ONE single close-and-open at center)
// =====================================================================
void performBlink() {
  for (int i = 0; i < 6; i++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_c[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(15); 
  }
  delay(30);
  for (int i = 5; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_c[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(15); 
  }
}

// =====================================================================
// TOUCH HANDLER & MULTI-TAP DETECTOR
// =====================================================================
void handleTouchAction() {
  unsigned long touchStart = millis();
  
  // Check for Long Hold (Continuous Touch) -> Expression A
  while (digitalRead(TOUCH_PIN) == HIGH) {
    if (millis() - touchStart > 800) {
      runExpressionA();
      return;
    }
    delay(10);
  }

  // Count taps if released quickly
  int tapCount = 1;
  unsigned long windowStart = millis();

  while (millis() - windowStart < 500) { // 500ms window to register multi-taps
    if (digitalRead(TOUCH_PIN) == HIGH) {
      // Debounce delay
      delay(50);
      while (digitalRead(TOUCH_PIN) == HIGH); // Wait for release
      tapCount++;
      windowStart = millis(); // Reset window on each new tap
      
      if (tapCount >= 5) {
        runExpressionD(); // 5 taps -> Angry Expression D sequence!
        return;
      }
    }
  }

  // If it was just 1, 2, 3, or 4 taps -> Expression B
  runExpressionB();
}

// =====================================================================
// SMART DELAY (Watches touch sensor constantly during long waits)
// =====================================================================
bool smartDelay(unsigned long ms) {
  unsigned long start = millis();
  while (millis() - start < ms) {
    if (digitalRead(TOUCH_PIN) == HIGH) {
      handleTouchAction();
      return true;
    }
    delay(15);
  }
  return false;
}

