    display.clearDisplay();
    display.drawBitmap(0, y, intro, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(10);
  }

  // 3. Coming alive: Play expression C in reverse (esp6 down to esp1) lag-free
  for (int i = 5; i >= 0; i--) {
    display.clearDisplay();
    display.drawBitmap(0, 0, expression_c[i], SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    delay(15);
  }
  
  delay(300); // Brief pause before starting main loop
}

void loop() {
  // Check touch right at the start of loop
  if (digitalRead(TOUCH_PIN) == HIGH) {
    handleTouchAction();
    return;
  }

  // Check if it's time for the sleeping expression F (Every 1 to 4 hours)
  if (millis() - lastSleepTime >= nextSleepInterval) {
    runExpressionF();
    lastSleepTime = millis();
    nextSleepInterval = random(3600000UL, 14400000UL); // Reset timer for next 1-4 hours
    return;
  }

  // ----------------------------------------------------
  // STEP 1: Main 'sinister' face
  // ----------------------------------------------------
  display.clearDisplay();
  display.drawBitmap(0, 0, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  
  unsigned long sinister_duration = random(3000, 15001);
  bool shouldBlink1 = (random(0, 2) == 1);
  bool shouldGlide = (random(0, 3) == 0); 

  if (shouldGlide) {
    if (smartDelay(random(500, 1200))) return;
    int chosenSide = random(0, 4);
    int targetX = (chosenSide == 0) ? -18 : (chosenSide == 1) ? 18 : 0;
    int targetY = (chosenSide == 2) ? -10 : (chosenSide == 3) ? 10 : 0;

    int currentX = 0, currentY = 0;
    while (currentX != targetX || currentY != targetY) {
      if (currentX < targetX) currentX++; else if (currentX > targetX) currentX--;
      if (currentY < targetY) currentY++; else if (currentY > targetY) currentY--;
      display.clearDisplay();
      display.drawBitmap(currentX, currentY, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      if (smartDelay(25)) return;
    }

    if (smartDelay(random(600, 1500))) return;

    while (currentX != 0 || currentY != 0) {
      if (currentX < 0) currentX++; else if (currentX > 0) currentX--;
      if (currentY < 0) currentY++; else if (currentY > 0) currentY--;
      display.clearDisplay();
      display.drawBitmap(currentX, currentY, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      if (smartDelay(25)) return;
    }
  }

  if (shouldBlink1 && sinister_duration > 4000) {
    unsigned long first_wait = random(1000, sinister_duration - 2000);
    if (smartDelay(first_wait)) return;
    performBlink();
    display.clearDisplay();
    display.drawBitmap(0, 0, sinister, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    if (smartDelay(sinister_duration - first_wait)) return;
  } else {
    if (smartDelay(sinister_duration)) return;
  }

  // ----------------------------------------------------
  // STEP 2: Second 'sinister_g' face
  // ----------------------------------------------------
  display.clearDisplay();
  display.drawBitmap(0, 0, sinister_g, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  
  bool shouldBlink2 = (random(0, 2) == 1);
  if (shouldBlink2) {
    if (smartDelay(1500)) return;
    performBlink();
    display.clearDisplay();
    display.drawBitmap(0, 0, sinister_g, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
    display.display();
    if (smartDelay(4500)) return;
  } else {
    if (smartDelay(6000)) return;
  }

  // ----------------------------------------------------
  // STEP 3: Random idle expression choice (A, B, C, D, or E)
  // ----------------------------------------------------
  int chosen_expression = random(0, 5); 
  if (chosen_expression == 0) runExpressionA();
  else if (chosen_expression == 1) runExpressionB();
  else if (chosen_expression == 2) runExpressionC();
  else if (chosen_expression == 3) runExpressionD();
  else runExpressionE();
}
