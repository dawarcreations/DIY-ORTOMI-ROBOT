    }
    for (int y = 8; y >= -8; y -= 3) {
      display.clearDisplay();
      display.drawBitmap(0, y, stp6, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      delay(12);
    }
    for (int y = -8; y <= 0; y += 3) {
      display.clearDisplay();
      display.drawBitmap(0, y, stp6, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
      display.display();
      delay(12);
    }
  }
  
  int random_hold = random(500, 3000);
  display.clearDisplay();
  display.drawBitmap(0, 0, stp6, SCREEN_WIDTH, SCREEN_HEIGHT, WHITE);
  display.display();
  delay(random_hold);

